# ==============================================================================
# KoparGov AI - Global Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env and frontend/.env) and fill in your values.
# NEVER commit real credentials or private keys to Git.

# --- Backend Configuration ---
PORT=8000
HOST=0.0.0.0
DEBUG=True

# --- Firebase Admin SDK (Backend) ---
# Path to service account key JSON file relative to backend/
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=kopargov-ai-demo
FIREBASE_DATABASE_URL=https://kopargov-ai-demo.firebaseio.com
# Optional: Firestore emulator host for local offline testing without cloud credentials
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Frontend Firebase Web SDK ---
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_FIREBASE_API_KEY=AIzaSySyntheticDemoApiKeyForHackathon_12345
VITE_FIREBASE_AUTH_DOMAIN=kopargov-ai-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kopargov-ai-demo
VITE_FIREBASE_STORAGE_BUCKET=kopargov-ai-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=100200300400
VITE_FIREBASE_APP_ID=1:100200300400:web:abcdef1234567890
